{
  "name": "mhrs-otorandevu",
  "version": "1.0.0",
  "description": "MHRS Otomatik Randevu Asistanı (Masaüstü Uygulaması)",
  "main": "app/main.js",
  "scripts": {
    "start": "electron .",
    "bot": "node bot.js",
    "pack": "electron-builder --dir",
    "dist": "electron-builder --win portable"
  },
  "build": {
    "appId": "com.mhrs.otorandevu",
    "productName": "MHRS-OtoRandevu",
    "directories": {
      "output": "dist"
    },
    "win": {
      "target": "portable",
      "icon": "app/assets/icon.png"
    },
    "portable": {
      "artifactName": "MHRS-OtoRandevu-Portable.exe"
    },
    "files": [
      "app/**/*",
      "functions.js",
      "package.json"
    ]
  },
  "author": "malierel",
  "license": "MIT",
  "dependencies": {
    "axios": "^1.7.7",
    "dotenv": "^18.0.7",
    "moment": "^2.30.1",
    "moment-timezone": "^0.5.46",
    "node-telegram-bot-api": "^0.66.0"
  },
  "devDependencies": {
    "electron": "^44.7.0",
    "electron-builder": "^26.15.3"
  }
}
